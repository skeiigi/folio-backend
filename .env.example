NODE_ENV=development
PORT=4000
# Local Postgres without Docker. Production requires DB_MODE=postgres and DATABASE_URL.
DB_MODE=pglite
DATABASE_URL=
PGLITE_PATH=.data/postgres
JWT_SECRET=replace-this-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_API_URL=http://localhost:4000
MAX_UPLOAD_MB=20
# Files survive API restarts in Postgres. Optional alternative: s3.
STORAGE_DRIVER=postgres
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Demo seeding is explicit; never creates accounts automatically on server startup.
DEMO_PASSWORD=FolioDemo2026!
# Optional integrations. Blank values disable external delivery.
RESEND_API_KEY=
MAIL_FROM=
CRM_WEBHOOK_URL=
BPMS_WEBHOOK_URL=
WEBHOOK_SECRET=
